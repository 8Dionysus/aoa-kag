{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa-kag/schemas/repo-local-kag-budget-receipt.schema.json",
  "title": "AoA repo-local KAG semantic budget receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "scope",
    "base_ref",
    "head_family_digest",
    "head_source_snapshot",
    "head_distribution_digest",
    "changed_generated_bytes",
    "changed_generated_files",
    "default_limit_bytes",
    "allowed_bytes",
    "tracked_bytes",
    "tracked_bytes_max",
    "allowed_tracked_bytes",
    "reason",
    "approved_by",
    "decision_ref",
    "semantic_admission",
    "semantic_evidence_ref",
    "semantic_evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "aoa-repo-local-kag-budget-receipt-v2"},
    "repo": {"type": "string", "minLength": 1},
    "scope": {"enum": ["generated_delta", "tracked_size", "generated_delta_and_tracked_size", "v2_to_v3_migration"]},
    "base_ref": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "head_family_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "head_source_snapshot": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "head_distribution_digest": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]},
    "changed_generated_bytes": {"type": "integer", "minimum": 0},
    "changed_generated_files": {"type": "integer", "minimum": 0},
    "default_limit_bytes": {"type": "integer", "minimum": 0},
    "allowed_bytes": {"type": "integer", "minimum": 0},
    "tracked_bytes": {"type": "integer", "minimum": 0},
    "tracked_bytes_max": {"type": "integer", "minimum": 0},
    "allowed_tracked_bytes": {"type": "integer", "minimum": 0},
    "reason": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "decision_ref": {"const": "aoa-kag:docs/decisions/AOA-KAG-D-0042-semantic-owner-evidence-for-budget-admission.md"},
    "semantic_admission": {"const": "supported"},
    "semantic_evidence_ref": {"type": "string", "pattern": "^kag/receipts/index_family_budget/[a-f0-9]{64}\\.evidence\\.json$"},
    "semantic_evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
