{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa-kag/schemas/repo-local-kag-budget-evidence.schema.json",
  "title": "AoA repo-local KAG semantic budget owner evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "owner",
    "scope",
    "base_identity",
    "head_identity",
    "procedure",
    "review",
    "cause",
    "measurements",
    "fixed_point"
  ],
  "properties": {
    "schema_version": {"const": "aoa-repo-local-kag-budget-evidence-v1"},
    "state": {"enum": ["supported", "unsupported", "unknown", "migration_required"]},
    "owner": {"$ref": "#/$defs/repo"},
    "scope": {"enum": ["generated_delta", "tracked_size", "generated_delta_and_tracked_size", "v2_to_v3_migration"]},
    "base_identity": {"$ref": "#/$defs/baseIdentity"},
    "head_identity": {"$ref": "#/$defs/headIdentity"},
    "procedure": {"$ref": "#/$defs/procedure"},
    "review": {"$ref": "#/$defs/review"},
    "cause": {"$ref": "#/$defs/cause"},
    "measurements": {"$ref": "#/$defs/measurements"},
    "fixed_point": {"$ref": "#/$defs/fixedPoint"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "owner_type", "root", "git_ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "pattern": "^aoa:[a-z0-9_.-]+$"},
        "owner_type": {"type": "string", "minLength": 1},
        "root": {"const": "."},
        "git_ref": {"type": "string", "minLength": 1}
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "owner_type", "root", "git_ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "pattern": "^aoa:[a-z0-9_.-]+$"},
        "owner_type": {"type": "string", "minLength": 1},
        "root": {"const": "."},
        "git_ref": {"type": "string", "minLength": 1}
      }
    },
    "baseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "family_digest", "source_snapshot", "distribution_digest"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "family_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "source_snapshot": {"anyOf": [{"$ref": "#/$defs/sha256Digest"}, {"type": "null"}]},
        "distribution_digest": {"anyOf": [{"$ref": "#/$defs/sha256Digest"}, {"type": "null"}]}
      }
    },
    "headIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_digest", "source_snapshot", "distribution_digest"],
      "properties": {
        "family_digest": {"$ref": "#/$defs/digest"},
        "source_snapshot": {"$ref": "#/$defs/sha256Digest"},
        "distribution_digest": {"anyOf": [{"$ref": "#/$defs/sha256Digest"}, {"type": "null"}]}
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "owner", "files", "digest"],
      "properties": {
        "contract_version": {"const": "aoa-kag:budget-semantic-admission-v2"},
        "owner": {"const": "aoa-kag"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "state"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "state": {"enum": ["present", "missing"]},
              "digest": {"$ref": "#/$defs/digest"}
            },
            "allOf": [
              {"if": {"properties": {"state": {"const": "present"}}}, "then": {"required": ["digest"]}},
              {"if": {"properties": {"state": {"const": "missing"}}}, "then": {"not": {"required": ["digest"]}}}
            ]
          }
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": {"type": "string", "pattern": "^aoa-kag:docs/decisions/.+\\.md$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "reason"],
      "properties": {
        "class": {"enum": ["deliberate_source_migration", "legitimate_bulk_authored_change", "schema_builder_migration", "accidental_generated_amplification", "hot_set_pressure", "shard_topology_pressure", "artifact_delivery_migration"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "files", "paths_digest"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "files": {"type": "integer", "minimum": 0},
        "paths_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "tracked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "limit_bytes"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "limit_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "amplification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_bytes", "authored_source_bytes", "ratio_numerator", "ratio_denominator"],
      "properties": {
        "generated_bytes": {"type": "integer", "minimum": 0},
        "authored_source_bytes": {"type": "integer", "minimum": 0},
        "ratio_numerator": {"type": "integer", "minimum": 0},
        "ratio_denominator": {"type": "integer", "minimum": 1}
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "groups"],
      "properties": {
        "state": {"enum": ["absent", "present"]},
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "paths"],
            "properties": {
              "digest": {"$ref": "#/$defs/digest"},
              "paths": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_delta", "tracked_size", "authored_source_delta", "amplification", "duplicate_materialization"],
      "properties": {
        "generated_delta": {"$ref": "#/$defs/measurement"},
        "tracked_size": {"$ref": "#/$defs/tracked"},
        "authored_source_delta": {"$ref": "#/$defs/measurement"},
        "amplification": {"$ref": "#/$defs/amplification"},
        "duplicate_materialization": {"$ref": "#/$defs/duplicates"}
      }
    },
    "fixedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "family_digest"],
      "properties": {
        "state": {"const": "required_external_gate"},
        "family_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
