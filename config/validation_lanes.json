{
  "schema_version": 1,
  "owner": "docs/validation/COMMAND_AUTHORITY.md",
  "command_authority": "config/validation_lanes.json",
  "notes": [
    "This manifest is the canonical storage surface for active validation lane command sequences.",
    "scripts/validation_lanes.py is the loader/API for Python callers; workflow YAML and release_check.py must not duplicate full lane sequences.",
    "The source-fast lane always runs validate_kag local scope; generated and compatibility lanes add one explicit OS-wide provider-home and coverage scope inside the same run-scoped packet epoch.",
    "Impact routing never replaces source-fast or the self owner-family check; it only decides whether an additional full OS-wide release audit is required."
  ],
  "lanes": {
    "source_fast": {
      "label": "source-fast",
      "posture": "blocking",
      "owner_surface": "docs/validation/VALIDATOR_TOPOLOGY.md",
      "command_sequence": "source_fast",
      "purpose": "Growth-safe read-only local integrity gate for route cards, mechanics skeleton, decision records, semantic AGENTS docs, unit tests, and committed KAG surfaces.",
      "does_not_own": [
        "OS-wide provider-home and coverage audit",
        "generated-output mutation",
        "release stabilization",
        "future runtime graph/vector/index state"
      ]
    },
    "generated": {
      "label": "generated",
      "posture": "blocking",
      "owner_surface": "docs/validation/VALIDATOR_TOPOLOGY.md",
      "command_sequence": "generated_check",
      "drift_paths": "generated",
      "purpose": "Generated/read-model parity plus one explicit blocking OS-wide provider-home and coverage audit for KAG outputs derived from manifests and source-owned exports.",
      "does_not_own": [
        "source repository authored meaning",
        "runtime graph/vector/index state"
      ]
    },
    "release": {
      "label": "release",
      "posture": "blocking",
      "owner_surface": "docs/RELEASING.md",
      "command_sequence": "release_check",
      "entrypoint": "scripts/release_check.py",
      "purpose": "Release-prep validation through source-fast and generated lanes.",
      "does_not_own": [
        "ordinary docs status",
        "GitHub dependency canary scheduling"
      ]
    },
    "compatibility_canary": {
      "label": "compatibility-canary",
      "posture": "blocking",
      "owner_surface": ".github/workflows/compatibility-canary.yml",
      "command_sequence": "compatibility_canary",
      "purpose": "Scheduled dependency compatibility check that reproduces unit, route, committed KAG, and generated-output drift checks against floating sibling checkouts.",
      "does_not_own": [
        "release artifact identity",
        "source repository authored meaning"
      ]
    },
    "advisory": {
      "label": "advisory",
      "posture": "non_blocking",
      "owner_surface": "docs/validation/VALIDATOR_TOPOLOGY.md",
      "purpose": "Boundary inventory for future graph/RAG/runtime/local-kag pressure that aoa-kag routes but does not yet own as hard validation.",
      "boundaries": [
        {
          "surface": "mechanics/part-local",
          "posture": "source_fast_when_listed",
          "owner_route": "mechanics/<package>/parts/<part>/ route card and validator",
          "local_check": "Active part-local tests are covered by scripts/run_tests.py; discovered build_*.py --check and validate_*.py part-local scripts are covered by scripts/run_part_local_checks.py."
        },
        {
          "surface": "runtime graph/vector/index state",
          "posture": "route_only",
          "owner_route": "future runtime or storage-owning repositories",
          "local_check": "aoa-kag checks portable derived contracts, not live runtime state."
        },
        {
          "surface": "source-authored meaning",
          "posture": "route_only",
          "owner_route": "source repositories and Tree of Sophia",
          "local_check": "KAG generated surfaces remain provenance-aware derived read models."
        }
      ]
    }
  },
  "drift_paths": {
    "generated": [
      "generated",
      "kag/indexes/index_family.manifest.json",
      "kag/indexes/shards"
    ]
  },
  "impact_routing": {
    "schema_version": 1,
    "default_route": "full-audit",
    "default_reason": "unknown-path",
    "always_required_proofs": [
      "source-fast",
      "owner-family"
    ],
    "full_audit_rules": [
      {
        "id": "artifact-or-pack-blob",
        "reason": "artifact, pack, archive, or opaque blob changed",
        "suffixes": [
          ".bin",
          ".blob",
          ".pack",
          ".pack.json",
          ".pack.jsonl",
          ".pack.zst",
          ".gz",
          ".tar",
          ".tar.gz",
          ".tgz",
          ".xz",
          ".zip",
          ".zst"
        ]
      },
      {
        "id": "provider-membership-or-federation-input",
        "reason": "provider membership, registry, readiness, or federation input changed",
        "prefixes": [
          "manifests/",
          "generated/",
          "kag/edges/",
          "kag/nodes/",
          "kag/projections/"
        ],
        "exact_paths": [
          "kag/indexes/provider_readiness_index.json"
        ]
      },
      {
        "id": "shared-schema-or-abi",
        "reason": "shared schema, KAG ABI, compatibility contract, or canonical model changed",
        "prefixes": [
          "schemas/"
        ],
        "exact_paths": [
          "AGENTS.md",
          "CHARTER.md",
          "DESIGN.AGENTS.md",
          "DESIGN.md",
          "README.md",
          "SECURITY.md",
          "docs/BOUNDARIES.md",
          "docs/CONSUMER_GUIDE.md",
          "docs/KAG_MODEL.md",
          "docs/RELEASING.md",
          "docs/SOURCE_POLICY.md",
          "kag/LOCAL_SUBTREE_PROTOCOL.md",
          "kag/README.md"
        ]
      },
      {
        "id": "builder-loader-validator-or-release-topology",
        "reason": "builder, loader, validator, test, release, or CI topology changed",
        "prefixes": [
          ".github/",
          "config/",
          "docs/decisions/",
          "docs/testing/",
          "docs/validation/",
          "scripts/",
          "tests/"
        ]
      },
      {
        "id": "trust-receipt-or-budget",
        "reason": "artifact trust, receipt, budget, or release artifact changed",
        "prefixes": [
          "dist/",
          "docs/artifact-bundles/",
          "kag/receipts/",
          "mechanics/audit/",
          "mechanics/release-support/"
        ]
      },
      {
        "id": "federation-or-projection-mechanic",
        "reason": "federation, projection, or cross-owner bridge mechanic changed",
        "prefixes": [
          "mechanics/boundary-bridge/"
        ]
      },
      {
        "id": "nested-derived-or-trust-surface",
        "reason": "nested schema, manifest, generated, projection, receipt, artifact, or pack surface changed",
        "segments": [
          "artifacts",
          "generated",
          "manifests",
          "packs",
          "policies",
          "projections",
          "receipts",
          "schemas"
        ]
      }
    ],
    "owner_local_rules": [
      {
        "id": "owner-authored-surface",
        "reason": "owner-authored documentation, mechanic, quest, skill, eval, or stats surface changed",
        "prefixes": [
          ".agents/",
          "docs/",
          "evals/",
          "mechanics/",
          "quests/",
          "skills/",
          "stats/"
        ],
        "exact_paths": [
          "CHANGELOG.md",
          "CODE_OF_CONDUCT.md",
          "CONTRIBUTING.md",
          "LICENSE",
          "QUESTBOOK.md",
          "ROADMAP.md"
        ]
      },
      {
        "id": "owner-portable-family-output",
        "reason": "self owner portable-family manifest or shard output changed",
        "prefixes": [
          "kag/indexes/shards/"
        ],
        "exact_paths": [
          "kag/indexes/index_family.manifest.json"
        ]
      }
    ]
  },
  "command_sequences": {
    "source_fast": [
      [
        "python",
        "scripts/run_tests.py"
      ],
      [
        "python",
        "scripts/run_part_local_checks.py"
      ],
      [
        "python",
        "scripts/validate_nested_agents.py"
      ],
      [
        "python",
        "scripts/validate_mechanics_skeleton.py"
      ],
      [
        "python",
        "scripts/generate_decision_indexes.py",
        "--check"
      ],
      [
        "python",
        "scripts/validate_decision_records.py"
      ],
      [
        "python",
        "scripts/validate_semantic_agents.py"
      ],
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "local"
      ],
      [
        "python",
        "scripts/validate_local_stats_port.py"
      ]
    ],
    "generated_check": [
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "local"
      ],
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "os-wide"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py"
      ],
      [
        "python",
        "scripts/generate_kag.py"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py"
      ],
      [
        "python",
        "scripts/generate_kag.py"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py",
        "--check"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family",
        "--check"
      ],
      [
        "python",
        "scripts/generate_kag.py",
        "--check"
      ],
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "local"
      ]
    ],
    "release_check": [
      [
        "python",
        "scripts/ci_gate.py",
        "--mode",
        "source-fast"
      ],
      [
        "python",
        "scripts/ci_gate.py",
        "--mode",
        "generated"
      ],
      [
        "python",
        "scripts/validate_abyss_machine_kag_registry_bundle.py"
      ]
    ],
    "compatibility_canary": [
      [
        "python",
        "scripts/run_tests.py"
      ],
      [
        "python",
        "scripts/validate_nested_agents.py"
      ],
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "local"
      ],
      [
        "python",
        "scripts/validate_kag.py",
        "--scope",
        "os-wide"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py"
      ],
      [
        "python",
        "scripts/generate_kag.py"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py"
      ],
      [
        "python",
        "scripts/generate_kag.py"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_coverage.py",
        "--check"
      ],
      [
        "python",
        "scripts/generate_repo_local_kag_index.py",
        "--repo-root",
        ".",
        "--output",
        "kag/indexes/source_surface_index.json",
        "--portable-family",
        "--check"
      ],
      [
        "python",
        "scripts/generate_kag.py",
        "--check"
      ],
      [
        "git",
        "diff",
        "--exit-code",
        "--",
        "generated",
        "kag/indexes/index_family.manifest.json",
        "kag/indexes/shards"
      ]
    ]
  }
}
